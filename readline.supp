{
   readline
   Memcheck:Leak
   match-leak-kinds: all
   fun:malloc
   ...
   fun:readline
}
{
   add_history
   Memcheck:Leak
   match-leak-kinds: all
   fun:malloc
   ...
   fun:add_history
}
{
   readline_init
   Memcheck:Leak
   match-leak-kinds: all
   ...
   fun:rl_initialize
}
{
   readline_internal
   Memcheck:Leak
   match-leak-kinds: all
   ...
   obj:*/libreadline.so.*
}
